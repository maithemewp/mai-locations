{
    "require": {
        "yahnis-elsts/plugin-update-checker": "^5",
        "giggsey/libphonenumber-for-php": "^9.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bizbudding/deployable-guard"
        }
    ],
    "require-dev": {
        "bizbudding/deployable-guard": "^1"
    },
    "autoload": {
        "psr-4": {
            "Mai\\Locations\\": "inc/classes/"
        }
    },
    "scripts": {
        "test-setup": "composer install -d tests",
        "test": "tests/vendor/bin/phpunit --configuration tests/phpunit.xml.dist",
        "stan": "tests/vendor/bin/phpstan analyse --configuration tests/phpstan.neon.dist --memory-limit=1G",
        "install-git-hooks": [
            "sh -c 'test -f vendor/bin/deployable-guard && php vendor/bin/deployable-guard install-hook || true'"
        ],
        "post-install-cmd": [
            "@install-git-hooks"
        ],
        "post-update-cmd": [
            "@install-git-hooks"
        ]
    }
}
