# Logs
*.log

# OS generated files
.DS_Store

# Node modules and build artifacts
node_modules/

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Laravel Mix files
npm-debug.log
yarn-error.log
yarn.lock
package-lock.json

# Production files (already included in dist/)
*.map

# Backup & deployment files
*.bak
*.swp
*.tmp
*.temp
*.orig

# IDE files
.idea/
*.sublime-project
*.sublime-workspace
.vscode/
*.code-workspace

# Sensitive files (update this list based on your actual use case)
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# vendor/ is committed (prod-only, --no-dev) so plugin updates apply without a
# composer build on the server. Allowlist: ignore everything under vendor/ except
# the autoloader, composer's own files, and each committed production package.
/vendor/*
!/vendor/autoload.php
!/vendor/composer/
# vendor/composer/installed.php regenerates with the current git ref (churns after
# every commit) and is never read at runtime, so do not track it. installed.json is
# the stable committed record.
/vendor/composer/installed.php
!/vendor/giggsey/
!/vendor/symfony/
!/vendor/yahnis-elsts/

# deployable-guard's generated pre-commit hook (dev-only; regenerated on install).
.githooks/
