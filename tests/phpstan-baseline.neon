parameters:
	ignoreErrors:
		-
			message: '#^Call to function class_exists\(\) with ''Mai_Geo_Query''\|''Mai_Locations…''\|''Mai_Locations_Block…''\|''Mai_Locations_CLI''\|''Mai_Locations_Count…''\|''Mai_Locations_Map…''\|''Mai_Locations_Table…'' and false will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: ../inc/aliases.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: ../inc/classes/Blocks/FilterBlock.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: ../inc/classes/Blocks/FilterBlock.php

		-
			message: '#^Parameter \#1 \$query of method WP_HTML_Tag_Processor\:\:next_tag\(\) expects array\{tag_name\?\: string\|null, match_offset\?\: int\|null, class_name\?\: string\|null, tag_closers\?\: string\|null\}\|null, ''a'' given\.$#'
			identifier: argument.type
			count: 1
			path: ../inc/classes/Blocks/FilterClearBlock.php

		-
			message: '#^Left side of \|\| is always false\.$#'
			identifier: booleanOr.leftAlwaysFalse
			count: 1
			path: ../inc/classes/Blocks/MapBlock.php

		-
			message: '#^Unable to resolve the template type T in call to function rest_sanitize_boolean$#'
			identifier: argument.templateType
